# Copier vers .env et renseigner les valeurs.
# La cle se trouve dans Supabase : Project Settings -> API -> anon public.
# N'utiliser JAMAIS la cle service_role ici : elle contourne toute la RLS
# et resterait extractible du binaire de l'application.

EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-public

# Mode apercu : ouvre l'application sans authentification, avec des donnees de
# demonstration, pour juger l'interface. Laisser vide ou a 0 en fonctionnement
# normal. Ne jamais activer dans une version distribuee.
EXPO_PUBLIC_PREVIEW=0
